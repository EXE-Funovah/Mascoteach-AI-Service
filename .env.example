# ========================================
# Core server
# ========================================
CONTAINER_NAME=mascoteach_ai
HOST_PORT=5001
PORT=5001
CORS_ORIGIN=*
JWT_KEY=
JWT_ISSUER=
JWT_AUDIENCE=
MASCOTEACH_BACKEND_API_BASE_URL=

# ========================================
# OpenAI quiz generation only
# ========================================
OPENAI_API_KEY=
OPENAI_QUIZ_MODEL=gpt-5-mini

# ========================================
# OpenAI Realtime live audio
# Required for mascot live conversation. The frontend joins OpenAI Realtime over WebRTC.
# ========================================
OPENAI_REALTIME_API_BASE_URL=https://api.openai.com
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_LANGUAGE=vi
# Current built-in Realtime voices from OpenAI docs:
# alloy, ash, ballad, coral, echo, sage, shimmer, verse, marin, cedar
# OpenAI currently recommends marin or cedar for best quality.
OPENAI_REALTIME_VOICE=marin
# Bot ESP pipeline uses server-side WebSocket Realtime with raw PCM audio.
# OpenAI Realtime PCM currently uses 24 kHz mono audio.
OPENAI_REALTIME_AUDIO_SAMPLE_RATE_HZ=24000
# Optional transcript/debug model for spoken user turns.
OPENAI_REALTIME_INPUT_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Server VAD tuning for the backend-owned bot session.
OPENAI_REALTIME_VAD_PREFIX_PADDING_MS=300
OPENAI_REALTIME_VAD_SILENCE_DURATION_MS=500
OPENAI_REALTIME_VAD_THRESHOLD=0.5
# low = cheaper/faster default for live conversation
# medium/high = more reasoning, potentially slower/more expensive
OPENAI_REALTIME_REASONING_EFFORT=low
# Keep replies short to control audio output cost.
OPENAI_REALTIME_MAX_OUTPUT_TOKENS=800
# Ephemeral client secret TTL in seconds. 300 = 5 minutes.
OPENAI_REALTIME_SESSION_TTL_SECONDS=300
MASCOT_LIVE_FREEMIUM_DAILY_LIMIT_SECONDS=300
MASCOT_LIVE_QUOTA_TIME_ZONE=Asia/Ho_Chi_Minh
# Optional override if you want to replace the default Sumadi prompt.
OPENAI_REALTIME_SYSTEM_PROMPT=

# ========================================
# Physical Mascobot ESP32 gateway
# S3-EYE uploads mic audio here; Main ESP polls commands here.
# ========================================
MASCOBOT_RESPONSE_AUDIO_BASE_URL=http://localhost:5001/api/v1/mascobot/audio
# Optional prototype shortcut: if set, each S3-EYE audio upload immediately queues this WAV URL for Main ESP playback.
MASCOBOT_TEST_AUDIO_URL=

# ========================================
# Live audio bridge for ESP32 EYE + MK101
# WebSocket paths:
#   /ws/mascobot/live/eye/:sessionId/:deviceId
#   /ws/mascobot/live/main/:sessionId/:deviceId
# Use the same sessionId on both ESPs, for example `live-test-01`.
# ========================================
