# ========================================
# Core server
# ========================================
PORT=5001
CORS_ORIGIN=*

# ========================================
# OpenAI quiz generation only
# ========================================
OPENAI_API_KEY=
OPENAI_QUIZ_MODEL=gpt-5-mini

# ========================================
# OpenAI Realtime live audio
# Required for mascot live conversation. The frontend joins OpenAI Realtime over WebRTC.
# ========================================
OPENAI_REALTIME_API_BASE_URL=https://api.openai.com
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_LANGUAGE=vi
# Current built-in Realtime voices from OpenAI docs:
# alloy, ash, ballad, coral, echo, sage, shimmer, verse, marin, cedar
# OpenAI currently recommends marin or cedar for best quality.
OPENAI_REALTIME_VOICE=marin
# low = cheaper/faster default for live conversation
# medium/high = more reasoning, potentially slower/more expensive
OPENAI_REALTIME_REASONING_EFFORT=low
# Keep replies short to control audio output cost.
OPENAI_REALTIME_MAX_OUTPUT_TOKENS=800
# Ephemeral client secret TTL in seconds. 300 = 5 minutes.
OPENAI_REALTIME_SESSION_TTL_SECONDS=300
# Optional override if you want to replace the default Sumadi prompt.
OPENAI_REALTIME_SYSTEM_PROMPT=
