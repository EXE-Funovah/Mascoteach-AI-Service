# ========================================
# Core server
# ========================================
PORT=5001
CORS_ORIGIN=*

# ========================================
# OpenAI quiz generation only
# ========================================
OPENAI_API_KEY=
OPENAI_QUIZ_MODEL=gpt-5-mini

# ========================================
# Agora Native ConvoAI / RTC
# Required for mascot live conversation. The frontend joins Agora RTC directly.
# ========================================
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=

# Optional, but recommended if your Agora ConvoAI setup gives you one.
AGORA_PROJECT_ID=
AGORA_CONVOAI_PIPELINE_ID=

# ========================================
# Optional Agora tuning
# ========================================
AGORA_CONVOAI_BASE_URL=https://api.agora.io/api/conversational-ai-agent/v2
AGORA_CONVOAI_IDLE_TIMEOUT_SECONDS=3600
AGORA_CONVOAI_GREETING_MESSAGE=Xin chào! Mình là Sumadi đây. Chúng ta cùng học nhé!
AGORA_CONVOAI_FAILURE_MESSAGE=Please hold on a second.
AGORA_RTC_TOKEN_EXPIRY_SECONDS=3600
AGORA_CHANNEL_PREFIX=mascot-live
MASCOT_LIVE_DEFAULT_LANGUAGE=vi
MASCOT_LIVE_DEFAULT_VOICE=friendly
AGORA_ASR_VENDOR=deepgram
AGORA_ASR_LANGUAGE=vi
AGORA_ASR_MODEL=nova-3
AGORA_ASR_URL=wss://api.deepgram.com/v1/listen
AGORA_LLM_VENDOR=openai
AGORA_LLM_MODEL=gpt-4.1-mini
AGORA_LLM_URL=https://api.openai.com/v1/chat/completions
AGORA_TTS_VENDOR=minimax
AGORA_TTS_MODEL=speech-2.6-turbo
AGORA_TTS_URL=wss://api-uw.minimax.io/ws/v1/t2a_v2
AGORA_TTS_VOICE_ID=Korean_AirheadedGirl

# Local debug only: create RTC session without calling Agora ConvoAI join API.
# Useful when mobile needs to test the local backend wiring before ConvoAI is enabled.
AGORA_SKIP_CONVOAI_JOIN_ON_CREATE=false
